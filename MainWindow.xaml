<Window x:Class="SG24MM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SG24MM"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#1E1E1E">

            <StackPanel>

                <TextBlock Text="SG24MM"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="25,30,25,5"/>

                <TextBlock Text="  Sonic Generations 2024 Mod Manager"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,20"/>

                <!-- Navigation -->
                <Button Content="Mods"
                        Height="45"
                        Margin="15,5"
                        FontSize="16"
                        Click="ModsNavigation_Click"/>

                <Button Content="Settings"
                        Height="45"
                        Margin="15,5"
                        FontSize="16"
                        Click="SettingsNavigation_Click"/>

            </StackPanel>

        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1"
              Background="#F5F5F5">

            <!-- MODS PAGE -->
            <Grid x:Name="ModsPage">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Content -->
                <StackPanel Grid.Row="0"
                            Margin="35,35,35,0">

                    <TextBlock Text="Mods"
                               FontSize="32"
                               FontWeight="Bold"/>

                    <TextBlock Text="Manage your Sonic Generations 2024 mods."
                               FontSize="15"
                               Foreground="#666666"
                               Margin="0,5,0,15"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,15">

                        <Button Content="Import Mod"
                                Width="140"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="ImportMod_Click"/>

                        <Button Content="Launch Game"
                                Width="140"
                                Height="40"
                                Click="LaunchGame_Click"/>

                    </StackPanel>

                    <TextBlock Text="Search Mods"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="SearchTextBox"
                             Width="300"
                             Height="35"
                             HorizontalAlignment="Left"
                             VerticalContentAlignment="Center"
                             ToolTip="Search mods by name"
                             TextChanged="SearchMods_TextChanged"
                             Margin="0,0,0,15"/>

                </StackPanel>

                <!-- Scrollable Mod List -->
                <Grid Grid.Row="1"
                      Margin="35,0,35,35">

                    <TextBlock x:Name="EmptyModsText"
                               Text="No mods imported"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel x:Name="ModListPanel"/>

                    </ScrollViewer>

                </Grid>

            </Grid>

            <!-- SETTINGS PAGE -->
            <Grid x:Name="SettingsPage"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Settings Header -->
                <StackPanel Grid.Row="0"
                            Margin="35,35,35,10">

                    <TextBlock Text="SG24MM Settings"
                               FontSize="32"
                               FontWeight="Bold"/>

                    <TextBlock Text="Configure your game location and mod page options."
                               Foreground="#666666"
                               FontSize="14"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- Settings -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="35,10,35,10">

                        <!-- Game Location -->
                        <Border Background="White"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,15">

                            <StackPanel>

                                <TextBlock Text="Game Location"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Sonic Generations 2024"
                                           Foreground="#666666"
                                           Margin="0,5,0,15"/>

                                <StackPanel Orientation="Horizontal">

                                    <TextBox x:Name="GamePathTextBox"
                                             Width="500"
                                             Height="35"
                                             VerticalContentAlignment="Center"
                                             IsReadOnly="True"
                                             Text="Game folder not selected"/>

                                    <Button Content="Browse..."
                                            Width="100"
                                            Height="35"
                                            Margin="10,0,0,0"
                                            Click="BrowseGameFolder_Click"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                        <!-- Mod Page Options -->
                        <Border Background="White"
                                CornerRadius="8"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Mod Page Options"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,15"/>

                                <CheckBox x:Name="ShowModFolderCheckBox"
                                          Content="Show Mod Folder"
                                          FontSize="15"
                                          Margin="0,8"/>

                                <CheckBox x:Name="ShowVerifyFilesCheckBox"
                                          Content="Show Verify Files"
                                          FontSize="15"
                                          Margin="0,8"/>

                                <CheckBox x:Name="ShowFilesCheckBox"
                                          Content="Show Files"
                                          FontSize="15"
                                          Margin="0,8"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- Settings Buttons -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="35,10,35,25">

                    <Button Content="Save"
                            Width="90"
                            Height="35"
                            Click="SaveSettings_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>